PORT=5000
# Atlas SRV 연결 (querySrv DNS 오류 시 아래 STANDARD 사용)
MONGODB_ATLAS_URL=
# Atlas 표준 연결 문자열(mongodb://, srv 아님) — SRV 실패 시 우선 적용
# MONGODB_ATLAS_STANDARD_URL=
# DNS 문제 시 선택: 8.8.8.8,1.1.1.1
# DNS_SERVERS=8.8.8.8,1.1.1.1
NODE_ENV=development
JWT_SECRET=interesthub-jwt-secret
JWT_EXPIRES_IN=7d

# 포인트 환급 Admin API (쉼표 구분 이메일)
ADMIN_EMAILS=admin@example.com